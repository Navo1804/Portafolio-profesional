# Copia este archivo como ".env" y completa tus datos reales.
# El archivo ".env" NUNCA debe subirse a GitHub (ya está en .gitignore).

SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# --- Configuración de correo (Gmail) ---
